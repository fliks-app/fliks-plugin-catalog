  "id": "fliks.tvdb",
  "ingestRoots": [],
  "kind": "process",
  "license": "AGPL-3.0-or-later",
  "logo": "logo.svg",
  "memoryMb": 64,
  "name": "TheTVDB",
  "pluginApi": 3,
  "provider": {
    "findBy": [
      "imdb"
    ],
    "imageHosts": [
      "artworks.thetvdb.com"
    ],
    "kinds": {
      "movie": [
        "search",
        "work",
        "person",
        "credits",
        "findBy"
      ],
      "series": [
        "search",
        "work",
        "children",
        "childStubs",
        "person",
        "credits",
        "findBy"
      ]
    },
    "limits": {
      "burst": 10,
      "ratePerSec": 10
    },
    "namespaces": [
      {
        "name": "tvdb"
      }
    ],
    "requestTimeoutMs": 10000,
    "requires": [
      "apiKey"
    ],
    "snapshotTtlSecs": {
      "children": 0,
      "work": 0
    }
  },
  "routes": [],
  "runtime": "wasm",
  "scopes": [],
  "ui": {
    "configPages": [
      {
        "fields": [
          {
            "default": "fliks:apiKey",
            "hint": "tvdb.config.apiKey_hint",
            "key": "apiKey",
            "labelKey": "tvdb.config.apiKey",
            "secret": true,
            "type": "text"
          }
        ],
        "id": "general",
        "labelKey": "tvdb.config.title",
        "subtitleKey": "tvdb.config.subtitle"
      }
