{
  "author": "Fliks",
  "database": {
    "coreRefs": [],
    "schema": true
  },
  "description": "Forwards Fliks domain events to an admin-configured HTTPS webhook, with bounded retry.",
  "files": {
    "logo.svg": "255f3e87b86c533d70a21763aa231c9d8a639be0f70c075172b656c54898d5f8",
    "plugin.wasm": "a79db4330cc7f7677d1816cbe40cd1616d3ef60064aca35ad6571724b7531c3e"
  },
  "fliks": ">=5.0.0 <6.0.0",
  "i18n": {
    "en": {
      "notify.config.subtitle": "Forward every event to a webhook.",
      "notify.config.target_url": "Target URL",
      "notify.config.target_url_hint": "HTTPS address that receives each event as JSON. It often embeds a token, so it is stored as a secret.",
      "notify.config.title": "Notify"
    },
    "fr": {
      "notify.config.subtitle": "Transmet chaque événement à un webhook.",
      "notify.config.target_url": "URL cible",
      "notify.config.target_url_hint": "Adresse HTTPS qui reçoit chaque événement en JSON. Elle contient souvent un jeton, elle est donc stockée comme secret.",
      "notify.config.title": "Notify"
    }
  },
  "id": "fliks.notify",
  "ingestRoots": [],
  "kind": "process",
  "license": "MIT",
  "logo": "logo.svg",
  "memoryMb": 64,
  "name": "Notify",
  "permissions": [
    "delivery-log",
    "test-delivery"
  ],
  "pluginApi": 2,
  "routes": [
    {
      "method": "GET",
      "path": "/delivery-log",
      "policy": "read:plugin:fliks.notify:delivery-log"
    },
    {
      "method": "POST",
      "path": "/test-delivery",
      "policy": "create:plugin:fliks.notify:test-delivery"
    }
  ],
  "runtime": "wasm",
  "scopes": [
    "config:rw"
  ],
  "ui": {
    "configPages": [
      {
        "fields": [
          {
            "hint": "notify.config.target_url_hint",
            "key": "target_url",
            "labelKey": "notify.config.target_url",
            "secret": true,
            "type": "url"
          }
        ],
        "id": "general",
        "labelKey": "notify.config.title",
        "subtitleKey": "notify.config.subtitle"
      }
    ],
    "contributions": [
      {
        "action": {
          "kind": "route",
          "path": "/admin/settings/plugins/fliks.notify/general"
        },
        "id": "fliks-notify.settings.general",
        "labelKey": "notify.config.title",
        "slot": "settings.page",
        "weight": 100
      }
    ]
  },
  "version": "1.0.0"
}