{
  "author": "Fliks",
  "database": {
    "coreRefs": [],
    "schema": false
  },
  "description": "Movie and series metadata, images, people and lists from The Movie Database.",
  "files": {
    "logo.svg": "d60f944647afd24f2c4917f767ce787afa6cc7de10ff588bc94c481de1353f9a",
    "plugin.wasm": "8d308fede770d957a3b19eed0a73252a7e409b976d1cf7964ddb42fecb83158e"
  },
  "fliks": ">=6.0.0 <7.0.0",
  "i18n": {
    "en": {
      "tmdb.config.apiKey": "API key",
      "tmdb.config.apiKey_hint": "Your own TMDB API key. Leave it empty to use the key Fliks ships with.",
      "tmdb.config.subtitle": "Movie and series metadata from The Movie Database.",
      "tmdb.config.title": "TMDB"
    },
    "fr": {
      "tmdb.config.apiKey": "Clé d'API",
      "tmdb.config.apiKey_hint": "Votre propre clé d'API TMDB. Laissez vide pour utiliser la clé fournie avec Fliks.",
      "tmdb.config.subtitle": "Métadonnées de films et de séries de The Movie Database.",
      "tmdb.config.title": "TMDB"
    }
  },
  "id": "fliks.tmdb",
  "ingestRoots": [],
  "kind": "process",
  "license": "AGPL-3.0-or-later",
  "logo": "logo.svg",
  "memoryMb": 64,
  "name": "TMDB",
  "pluginApi": 3,
  "provider": {
    "findBy": [
      "imdb",
      "tvdb"
    ],
    "imageHosts": [
      "image.tmdb.org"
    ],
    "kinds": {
      "movie": [
        "search",
        "work",
        "person",
        "credits",
        "findBy",
        "lists"
      ],
      "series": [
        "search",
        "work",
        "children",
        "childStubs",
        "person",
        "credits",
        "findBy",
        "lists"
      ]
    },
    "limits": {
      "burst": 40,
      "ratePerSec": 40
    },
    "namespaces": [
      {
        "name": "tmdb"
      }
    ],
    "requestTimeoutMs": 10000,
    "requires": [
      "apiKey"
    ],
    "snapshotTtlSecs": {
      "children": 0,
      "work": 0
    }
  },
  "routes": [],
  "runtime": "wasm",
  "scopes": [],
  "ui": {
    "configPages": [
      {
        "fields": [
          {
            "default": "fliks:apiKey",
            "hint": "tmdb.config.apiKey_hint",
            "key": "apiKey",
            "labelKey": "tmdb.config.apiKey",
            "secret": true,
            "type": "text"
          }
        ],
        "id": "general",
        "labelKey": "tmdb.config.title",
        "subtitleKey": "tmdb.config.subtitle"
      }
    ],
    "contributions": [
      {
        "action": {
          "kind": "route",
          "path": "/admin/settings/plugins/fliks.tmdb/general"
        },
        "id": "fliks-tmdb.settings.general",
        "labelKey": "tmdb.config.title",
        "slot": "settings.page",
        "weight": 100
      }
    ]
  },
  "version": "0.3.0"
}